generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id           String            @id @default(cuid())
  category     String
  title        String            @db.Text
  excerpt      String            @db.Text
  content      String            @db.LongText
  author       String
  clickCount   Int               @default(0)
  likeCount    Int               @default(0)
  dislikeCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  postImage         String?           @db.LongText
  imageFocus        String?           @db.VarChar(32)
  imageFocusHero    String?           @db.VarChar(32)
  imageFocusGround  String?           @db.VarChar(32)
  authorImage       String?           @db.LongText
  authorUserId String?
  uploaderName String?
  isHidden     Boolean           @default(false)
  User         User?             @relation(fields: [authorUserId], references: [id])
  comments     ArticleComment[]
  reactions    ArticleReaction[]
  savedBy      SavedArticle[]

  @@index([authorUserId], map: "BlogPost_authorUserId_fkey")
}

model ArticleComment {
  id         String   @id @default(cuid())
  blogPostId String
  name       String
  email      String
  comment    String   @db.Text
  visitorId  String?
  createdAt  DateTime @default(now())
  BlogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([visitorId])
}

model ArticleReaction {
  id         String   @id @default(cuid())
  blogPostId String
  visitorId  String
  reaction   String
  createdAt  DateTime @default(now())
  BlogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, visitorId])
  @@index([blogPostId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(CONTRIBUTOR)
  active       Boolean    @default(true)
  permissions  String?    @db.LongText
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  BlogPost     BlogPost[]
  savedArticles SavedArticle[]
  authorFollows AuthorFollow[]
}

model SavedArticle {
  id         String   @id @default(cuid())
  userId     String
  blogPostId String
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  BlogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([userId, blogPostId])
  @@index([userId])
  @@index([blogPostId])
}

model AuthorFollow {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([userId])
  @@index([authorId])
}

model AbhiyanEvent {
  id        String   @id
  title     String
  date      String
  time      String
  location  String
  details   String   @db.LongText
  imageUrl  String?  @db.LongText
  createdAt DateTime @default(now())
}

model Otp {
  id        String   @id
  email     String
  code      String
  purpose   String   @default("register")
  attempts  Int      @default(0)
  expiresAt DateTime
  verified  Boolean  @default(false)

  @@index([email])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  type      String
  url       String?
  fileData  String?  @db.LongText
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  phone       String?
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([email])
}

enum Role {
  MASTER_ADMIN
  ADMIN
  CONTRIBUTOR
}

model SiteConfig {
  id        String   @id
  value     String   @db.LongText
  updatedAt DateTime @default(now()) @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StruggleTracker {
  id           String   @id @default(cuid())
  name         String
  // One of the fixed keys in STRUGGLE_STATUSES (active/strike/success); the Hindi label and the
  // badge class are both derived from it, so the homepage badge colours stay stable.
  status       String   @db.VarChar(32)
  location     String
  description  String   @db.Text
  sinceDate    DateTime
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([isActive, displayOrder])
}

model PushSubscription {
  id           String   @id @default(cuid())
  visitorId    String
  // Push endpoints exceed MySQL's 191-char index limit, so uniqueness is held by a sha256 of it.
  endpointHash String   @unique
  subscription String   @db.Text
  affinity     String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([visitorId])
}

